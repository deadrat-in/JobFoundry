{
  "name": "jobfoundry-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:all": "wxt build && wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "gen:provider-index": "node scripts/gen-provider-index.mjs",
    "pretest": "node scripts/gen-provider-index.mjs",
    "test": "node --test test/*.test.mjs",
    "postinstall": "wxt prepare",
    "vendor": "node scripts/vendor.mjs",
    "sync:providers": "node scripts/sync-providers.mjs"
  },
  "devDependencies": {
    "@webext-core/messaging": "^4.0.0",
    "@wxt-dev/storage": "^1.2.9",
    "jsdom": "^30.0.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "wxt": "^0.21.4"
  }
}
