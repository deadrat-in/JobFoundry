{
  "manifest_version": 3,
  "name": "JobFoundry",
  "version": "0.1.0",
  "description": "Capture job postings in your browser and push them to your JobFoundry server.",
  "action": {
    "default_title": "JobFoundry",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "alarms"],
  "content_scripts": [
    {
      "matches": [
        "*://*.linkedin.com/*",
        "*://*.indeed.com/*",
        "*://*.indeed.co.uk/*",
        "*://*.indeed.ca/*",
        "*://*.indeed.de/*",
        "*://*.indeed.fr/*",
        "*://*.indeed.co.in/*",
        "*://*.glassdoor.com/*",
        "*://*.glassdoor.co.in/*",
        "*://*.glassdoor.co.uk/*",
        "*://*.naukri.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
