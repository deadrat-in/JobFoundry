{
  "manifest_version": 2,
  "name": "JobFoundry",
  "version": "0.1.0",
  "description": "Capture job postings in your browser and push them to your JobFoundry server.",
  "browser_action": {
    "default_title": "JobFoundry",
    "default_popup": "popup.html"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "permissions": [
    "storage",
    "alarms",
    "*://*.linkedin.com/*",
    "*://*.indeed.com/*",
    "*://*.indeed.co.uk/*",
    "*://*.indeed.ca/*",
    "*://*.indeed.de/*",
    "*://*.indeed.fr/*",
    "*://*.indeed.co.in/*",
    "*://*.glassdoor.com/*",
    "*://*.glassdoor.co.in/*",
    "*://*.glassdoor.co.uk/*",
    "*://*.naukri.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.linkedin.com/*",
        "*://*.indeed.com/*",
        "*://*.indeed.co.uk/*",
        "*://*.indeed.ca/*",
        "*://*.indeed.de/*",
        "*://*.indeed.fr/*",
        "*://*.indeed.co.in/*",
        "*://*.glassdoor.com/*",
        "*://*.glassdoor.co.in/*",
        "*://*.glassdoor.co.uk/*",
        "*://*.naukri.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "jobfoundry@local"
    }
  }
}
