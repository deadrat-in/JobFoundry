---
import DocsLayout from '../../layouts/DocsLayout.astro';
import { resolvePath } from '../../utils/paths.js';
---

<DocsLayout
  title="Documentation Hub"
  description="Comprehensive documentation for JobFoundry local-first pipeline, companion extension, and LLM scoring."
  currentPath={resolvePath('/docs/')}
  category="Overview"
>
  <h1>JobFoundry Documentation</h1>
  <p class="lead-text">
    JobFoundry is a local-first, privacy-respecting pipeline designed to find jobs across 84+ platforms, deduplicate cross-postings, score candidate fit with local LLMs, and compile tailored ATS-compliant resumes.
  </p>

  <div class="doc-callout">
    <div class="callout-title">
      <span>◈</span>
      <span>Architectural Invariant</span>
    </div>
    <p>
      The JobFoundry server never performs outbound job-board scraping. All scraping and job-board HTTP requests originate from the user's browser extension using existing authenticated sessions.
    </p>
  </div>

  <h2>Documentation Sections</h2>
  <div class="docs-grid">
    <a href={resolvePath('/docs/getting-started/')} class="doc-card">
      <div class="card-header-row">
        <span class="card-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="4 17 10 11 4 5"></polyline>
            <line x1="12" y1="19" x2="20" y2="19"></line>
          </svg>
        </span>
        <span class="card-num">01</span>
      </div>
      <h3 class="card-heading">Getting Started</h3>
      <p class="card-desc">
        Install the daemon via Podman, Docker Compose, or native CLI. Configure local LLMs (Ollama/vLLM) and verify server health.
      </p>
      <span class="card-cta">View Setup Guide →</span>
    </a>

    <a href={resolvePath('/docs/extension/')} class="doc-card">
      <div class="card-header-row">
        <span class="card-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M20.24 12.24a6 6 0 0 0-8.49-8.49L5 10.5V19h8.5z"></path>
            <line x1="16" y1="8" x2="2" y2="22"></line>
            <line x1="17.5" y1="15" x2="9" y2="15"></line>
          </svg>
        </span>
        <span class="card-num">02</span>
      </div>
      <h3 class="card-heading">Browser Extension</h3>
      <p class="card-desc">
        Companion browser extension for Chrome, Brave, Edge, and Firefox. Download releases and follow manual unpack instructions.
      </p>
      <span class="card-cta">View Extension Manual →</span>
    </a>

    <a href={resolvePath('/docs/architecture/')} class="doc-card">
      <div class="card-header-row">
        <span class="card-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="2" y="2" width="6" height="6" rx="1"></rect>
            <rect x="16" y="2" width="6" height="6" rx="1"></rect>
            <rect x="9" y="16" width="6" height="6" rx="1"></rect>
            <path d="M5 8v3a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8"></path>
            <line x1="12" y1="13" x2="12" y2="16"></line>
          </svg>
        </span>
        <span class="card-num">03</span>
      </div>
      <h3 class="card-heading">Pipeline Architecture</h3>
      <p class="card-desc">
        Deep dive into the 5-stage pipeline: Ingestion, 64-bit SimHash deduplication, LLM fit scorer schema, and Typst tailoring.
      </p>
      <span class="card-cta">Explore Architecture →</span>
    </a>

    <a href={resolvePath('/docs/providers/')} class="doc-card">
      <div class="card-header-row">
        <span class="card-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="2" y1="12" x2="22" y2="12"></line>
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1 4-10z"></path>
          </svg>
        </span>
        <span class="card-num">04</span>
      </div>
      <h3 class="card-heading">Supported Providers</h3>
      <p class="card-desc">
        Explore 84+ supported ATS and job boards (Workday, Greenhouse, Lever, Ashby, LinkedIn, Indeed, Dice) with extraction modes.
      </p>
      <span class="card-cta">Browse Directory →</span>
    </a>

    <a href={resolvePath('/docs/privacy/')} class="doc-card">
      <div class="card-header-row">
        <span class="card-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          </svg>
        </span>
        <span class="card-num">05</span>
      </div>
      <h3 class="card-heading">Privacy & Invariants</h3>
      <p class="card-desc">
        Zero analytics, no third-party telemetry, local SQLite storage, and architectural principles guaranteeing full data ownership.
      </p>
      <span class="card-cta">Read Guarantees →</span>
    </a>

    <a href={resolvePath('/feedback/')} class="doc-card">
      <div class="card-header-row">
        <span class="card-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
          </svg>
        </span>
        <span class="card-num">06</span>
      </div>
      <h3 class="card-heading">Feedback & Support</h3>
      <p class="card-desc">
        Submit bug reports, request new job-board providers, share feature proposals, or contribute to JobFoundry.
      </p>
      <span class="card-cta">Join Community →</span>
    </a>
  </div>
</DocsLayout>

<style>
  .lead-text {
    font-size: 1.15rem;
    color: var(--text-primary);
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .docs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
    margin-top: 1.5rem;
  }

  .doc-card {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xs);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    text-decoration: none !important;
    transition: all 0.15s ease;
  }

  .doc-card:hover {
    border-color: var(--accent-cyan);
    background-color: var(--bg-surface-elevated);
    transform: translateY(-2px);
  }

  .card-header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
  }

  .card-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--accent-cyan);
    background: var(--accent-cyan-bg);
    border: 1px solid var(--border-subtle);
    padding: 6px;
    border-radius: var(--radius-xs);
  }

  .card-num {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--text-muted);
  }

  .card-heading {
    font-size: 1.15rem;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
  }

  .card-desc {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.5;
    flex: 1;
    margin-bottom: 1rem;
  }

  .card-cta {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--accent-cyan);
  }
</style>
