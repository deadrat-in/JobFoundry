---
import { resolvePath } from '../utils/paths.js';

interface Props {
  currentPath?: string;
}

const { currentPath = '' } = Astro.props;

const docSections = [
  {
    title: 'Overview',
    items: [
      { label: 'Documentation Hub', href: resolvePath('/docs/'), icon: 'hub' },
      { label: 'Getting Started', href: resolvePath('/docs/getting-started/'), icon: 'rocket' },
    ],
  },
  {
    title: 'Components',
    items: [
      { label: 'Browser Extension', href: resolvePath('/docs/extension/'), icon: 'extension' },
      { label: 'Pipeline Architecture', href: resolvePath('/docs/architecture/'), icon: 'pipeline' },
      { label: 'Supported Providers (84+)', href: resolvePath('/docs/providers/'), icon: 'providers' },
    ],
  },
  {
    title: 'Trust & Governance',
    items: [
      { label: 'Privacy & Invariants', href: resolvePath('/docs/privacy/'), icon: 'shield' },
      { label: 'AGPL-3.0 License', href: resolvePath('/license/'), icon: 'license' },
      { label: 'Community Feedback', href: resolvePath('/feedback/'), icon: 'feedback' },
    ],
  },
];
---

<aside class="docs-sidebar" aria-label="Documentation Sidebar">
  <div class="sidebar-header">
    <span class="sidebar-tag">JOBFOUNDRY DOCS</span>
  </div>

  <nav class="sidebar-nav">
    {docSections.map((section) => (
      <div class="nav-section">
        <h3 class="section-title">{section.title}</h3>
        <ul class="section-list">
          {section.items.map((item) => {
            const isActive = currentPath === item.href || (item.href !== resolvePath('/docs/') && currentPath.startsWith(item.href));
            return (
              <li>
                <a href={item.href} class:list={['nav-item-link', { active: isActive }]}>
                  <span class="item-icon">
                    {item.icon === 'hub' && (
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
                        <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
                      </svg>
                    )}
                    {item.icon === 'rocket' && (
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="4 17 10 11 4 5"></polyline>
                        <line x1="12" y1="19" x2="20" y2="19"></line>
                      </svg>
                    )}
                    {item.icon === 'extension' && (
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M20.24 12.24a6 6 0 0 0-8.49-8.49L5 10.5V19h8.5z"></path>
                        <line x1="16" y1="8" x2="2" y2="22"></line>
                        <line x1="17.5" y1="15" x2="9" y2="15"></line>
                      </svg>
                    )}
                    {item.icon === 'pipeline' && (
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="2" y="2" width="6" height="6" rx="1"></rect>
                        <rect x="16" y="2" width="6" height="6" rx="1"></rect>
                        <rect x="9" y="16" width="6" height="6" rx="1"></rect>
                        <path d="M5 8v3a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8"></path>
                        <line x1="12" y1="13" x2="12" y2="16"></line>
                      </svg>
                    )}
                    {item.icon === 'providers' && (
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="2" y1="12" x2="22" y2="12"></line>
                        <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
                      </svg>
                    )}
                    {item.icon === 'shield' && (
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                      </svg>
                    )}
                    {item.icon === 'license' && (
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                        <polyline points="14 2 14 8 20 8"></polyline>
                        <line x1="16" y1="13" x2="8" y2="13"></line>
                        <line x1="16" y1="17" x2="8" y2="17"></line>
                      </svg>
                    )}
                    {item.icon === 'feedback' && (
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
                      </svg>
                    )}
                  </span>
                  <span class="item-label">{item.label}</span>
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    ))}
  </nav>

  <div class="sidebar-footer">
    <div class="invariant-box">
      <span class="box-dot"></span>
      <span class="box-text">Local-First Engine</span>
    </div>
  </div>
</aside>

<style>
  .docs-sidebar {
    width: 260px;
    flex-shrink: 0;
    position: sticky;
    top: 56px;
    height: calc(100vh - 56px);
    overflow-y: auto;
    padding: 2rem 1.5rem;
    border-right: 1px solid var(--border-subtle);
    background-color: var(--bg-surface);
  }

  .sidebar-header {
    margin-bottom: 1.5rem;
  }

  .sidebar-tag {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--accent-cyan);
    background: var(--accent-cyan-bg);
    border: 1px solid var(--border-subtle);
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-xs);
  }

  .sidebar-nav {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .section-title {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    margin-bottom: 0.6rem;
  }

  .section-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .nav-item-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.65rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-secondary);
    text-decoration: none !important;
    border-radius: var(--radius-xs);
    border-left: 2px solid transparent;
    transition: all 0.15s ease;
  }

  .item-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    flex-shrink: 0;
  }

  .nav-item-link:hover .item-icon,
  .nav-item-link.active .item-icon {
    color: var(--accent-cyan);
  }

  .nav-item-link:hover {
    color: var(--text-primary);
    background-color: var(--bg-surface-elevated);
  }

  .nav-item-link.active {
    color: var(--accent-cyan);
    background-color: var(--accent-cyan-bg);
    border-left-color: var(--accent-cyan);
    font-weight: 600;
  }

  .sidebar-footer {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-subtle);
  }

  .invariant-box {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .box-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--accent-emerald);
  }

  @media (max-width: 768px) {
    .docs-sidebar {
      display: none;
    }
  }
</style>
