---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class:list={['telemetry-divider-wrapper', className]} aria-hidden="true">
  <canvas id="telemetry-canvas" class="telemetry-canvas"></canvas>
</div>

<style>
  .telemetry-divider-wrapper {
    width: 100%;
    width: 100vw;
    max-width: 100vw;
    height: 64px;
    position: relative;
    overflow: hidden;
    pointer-events: none;
    display: flex;
    align-items: center;
  }

  .telemetry-canvas {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>

<script>
  function setupTelemetryCanvas() {
    const canvas = document.getElementById('telemetry-canvas') as HTMLCanvasElement | null;
    if (!canvas) return;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let width = 0;
    let height = 0;
    let time = 0;
    let animId = 0;
    let isVisible = true;

    function resize() {
      if (!canvas) return;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = canvas.offsetWidth;
      height = canvas.offsetHeight;
      canvas.width = Math.floor(width * dpr);
      canvas.height = Math.floor(height * dpr);
      ctx?.scale(dpr, dpr);
    }

    function animate() {
      if (!isVisible || !ctx) {
        animId = requestAnimationFrame(animate);
        return;
      }

      ctx.clearRect(0, 0, width, height);

      const isDark = document.documentElement.classList.contains('dark');

      // Center reference baseline
      ctx.strokeStyle = isDark ? 'rgba(148, 163, 184, 0.08)' : 'rgba(15, 23, 42, 0.06)';
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(0, height / 2);
      ctx.lineTo(width, height / 2);
      ctx.stroke();

      // Wave 2: Secondary Violet Harmonic (smoother, lagging)
      ctx.strokeStyle = isDark ? 'rgba(167, 139, 250, 0.35)' : 'rgba(124, 58, 237, 0.25)';
      ctx.lineWidth = 1.2;
      ctx.beginPath();
      for (let x = 0; x <= width; x += 3) {
        const y = height / 2 +
          Math.sin(x * 0.005 - time * 0.8) * 16 +
          Math.cos(x * 0.012 + time * 1.2) * 8;
        if (x === 0) ctx.moveTo(x, y);
        else ctx.lineTo(x, y);
      }
      ctx.stroke();

      // Wave 1: Primary Sky-Blue Signal (dynamic dual-frequency)
      ctx.strokeStyle = isDark ? 'rgba(56, 189, 248, 0.65)' : 'rgba(2, 132, 199, 0.55)';
      ctx.lineWidth = 1.8;
      ctx.beginPath();
      for (let x = 0; x <= width; x += 2) {
        const y = height / 2 +
          Math.sin(x * 0.007 + time) * 20 +
          Math.sin(x * 0.018 + time * 1.5) * 10;
        if (x === 0) ctx.moveTo(x, y);
        else ctx.lineTo(x, y);
      }
      ctx.stroke();

      time += 0.035;
      animId = requestAnimationFrame(animate);
    }

    // Performance: Pause when scrolled offscreen
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          isVisible = entry.isIntersecting;
        });
      },
      { threshold: 0 }
    );
    observer.observe(canvas);

    window.addEventListener('resize', resize);
    resize();
    animate();
  }

  setupTelemetryCanvas();
  document.addEventListener('astro:page-load', setupTelemetryCanvas);
</script>
