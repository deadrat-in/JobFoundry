---
import { resolvePath } from '../utils/paths.js';
---

<footer class="footer">
  <div class="site-container">
    <div class="footer-top">
      <div class="footer-brand">
        <div class="footer-logo">
          <img src={resolvePath('/icons/icon-32.png')} alt="" width="20" height="20" class="footer-logo-img" />
          <span class="logo-text">JobFoundry</span>
        </div>
        <p class="footer-description">
          Local-first AI pipeline for job search, fit scoring, resume tailoring, and ATS export. Free and open source.
        </p>
        <div class="footer-invariant">
          <span class="invariant-tag">Architectural Invariant</span>
          <p class="invariant-text">
            The JobFoundry server never performs outbound job-board scraping. All scraping and job-board HTTP requests originate from the user's browser extension.
          </p>
        </div>
      </div>

      <div class="footer-links-grid">
        <div class="footer-col">
          <h4 class="col-heading">Documentation</h4>
          <ul class="col-list">
            <li><a href={resolvePath('/docs/getting-started/')}>Getting Started</a></li>
            <li><a href={resolvePath('/docs/extension/')}>Browser Extension</a></li>
            <li><a href={resolvePath('/docs/architecture/')}>Pipeline Architecture</a></li>
            <li><a href={resolvePath('/docs/providers/')}>Supported Providers (84+)</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <h4 class="col-heading">Community & Code</h4>
          <ul class="col-list">
            <li><a href="https://github.com/deadrat-in/JobFoundry" target="_blank" rel="noopener noreferrer">GitHub Repository</a></li>
            <li><a href="https://github.com/deadrat-in/JobFoundry/releases" target="_blank" rel="noopener noreferrer">Release Downloads</a></li>
            <li><a href={resolvePath('/feedback/')}>Feedback & Issues</a></li>
            <li><a href="https://github.com/deadrat-in/JobFoundry/blob/main/CONTRIBUTING.md" target="_blank" rel="noopener noreferrer">Contributing</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <h4 class="col-heading">Legal & Trust</h4>
          <ul class="col-list">
            <li><a href={resolvePath('/docs/privacy/')}>Privacy & Local-First</a></li>
            <li><a href={resolvePath('/license/')}>AGPL-3.0 License</a></li>
            <li><a href="https://github.com/deadrat-in/JobFoundry/blob/main/SECURITY.md" target="_blank" rel="noopener noreferrer">Security Policy</a></li>
          </ul>
        </div>
      </div>
    </div>

    <hr class="hairline" />

    <div class="footer-bottom">
      <p class="copyright">
        © {new Date().getFullYear()} JobFoundry Contributors. AGPL-3.0 Licensed. No tracking cookies. Zero telemetry.
      </p>
      <div class="footer-meta">
        <span class="status-indicator">
          <span class="status-dot"></span>
          <span>100% Local-First</span>
        </span>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    margin-top: auto;
    background-color: var(--bg-surface);
    border-top: 1px solid var(--border-subtle);
    padding: 3.5rem 0 2rem;
  }

  .footer-top {
    display: grid;
    grid-template-columns: 1.4fr 2fr;
    gap: 3rem;
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--text-primary);
    margin-bottom: 0.75rem;
  }

  .logo-glyph {
    color: var(--accent-cyan);
  }

  .footer-description {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin-bottom: 1.25rem;
  }

  .footer-invariant {
    background: var(--bg-surface-elevated);
    border: 1px solid var(--border-subtle);
    border-left: 3px solid var(--accent-cyan);
    border-radius: var(--radius-xs);
    padding: 0.75rem 1rem;
  }

  .invariant-tag {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent-cyan);
    margin-bottom: 0.35rem;
  }

  .invariant-text {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-secondary);
    margin-bottom: 0;
    line-height: 1.4;
  }

  .footer-links-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .col-heading {
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-primary);
    margin-bottom: 1rem;
  }

  .col-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .col-list a {
    font-size: 0.875rem;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .col-list a:hover {
    color: var(--accent-cyan);
    text-decoration: underline;
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    padding-top: 0.5rem;
  }

  .copyright {
    font-size: 0.8rem;
    color: var(--text-muted);
    margin-bottom: 0;
  }

  .status-indicator {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--accent-emerald);
    background: var(--accent-emerald-bg);
    border: 1px solid var(--accent-emerald);
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-xs);
  }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--accent-emerald);
  }

  @media (max-width: 900px) {
    .footer-top {
      grid-template-columns: 1fr;
    }

    .footer-links-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .footer-links-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
