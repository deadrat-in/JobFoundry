# JobFoundry Environment Variables

# Ingest Server & API Auth
PORT=8080
API_KEYS=secret-api-key-1,secret-api-key-2
DB_PATH=/data/jobfoundry.db
ARTIFACTS_DIR=/data/artifacts

# Scorer / Tailoring Bridge
SCORER_MODEL=gpt-4o-mini
SCORER_PROVIDER=openai
SCORER_THRESHOLD=75
RESUME_OPS_URL=http://resume-ops:8081

# Web Dashboard
VITE_API_URL=http://localhost:8080
