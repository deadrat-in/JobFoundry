# ==============================================================================
# JobFoundry - Environment Configuration
# All-in-One Container (Web Dashboard + Ingest API + Fit Scorer + Tailor Engine)
# ==============================================================================

# Server & API Authentication (Unified Port 8080)
PORT=8080
API_KEYS=secret-api-key-1,secret-api-key-2
DB_PATH=/data/jobfoundry.db
ARTIFACTS_DIR=/data/artifacts
DATA_DIR=/data
MASTER_RESUME_PATH=/data/master-resume.json

# LLM Fit Scorer
SCORER_MODEL=openrouter/z-ai/glm-5.3-flash
SCORER_PROVIDER=openrouter
SCORER_THRESHOLD=75
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_API_BASE=https://openrouter.ai/api/v1

# LLM Resume Tailoring (resume-ops)
TAILOR_MODEL=openrouter/qwen/qwen3.8-max
ALLOWED_THEMES="jsonresume-theme-folio jsonresume-theme-stackoverflow"
LLM_REQUEST_TIMEOUT=600
TAILOR_TIMEOUT_SECONDS=900
TAILOR_TIMEOUT_MS=1800000

# Logging & LLM Observability (Opik Cloud or Local)
LOG_LEVEL=info
OPIK_PROJECT_NAME=jobfoundry
OPIK_API_KEY=
OPIK_WORKSPACE=
OPIK_URL_OVERRIDE=
