# JobFoundry Environment Variables

# Ingest Server & API Auth
PORT=8080
API_KEYS=secret-api-key-1,secret-api-key-2
DB_PATH=/data/jobfoundry.db
ARTIFACTS_DIR=/data/artifacts

# Scorer / Tailoring Bridge
SCORER_MODEL=openrouter/google/gemini-2.0-flash-exp:free
SCORER_PROVIDER=openrouter
SCORER_THRESHOLD=75
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
RESUME_OPS_URL=http://resume-ops:8081

# Web Dashboard
VITE_API_URL=http://localhost:8080
