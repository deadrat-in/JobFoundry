<?xml version="1.0" encoding="utf-8"?>
<Package
    xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
    xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
    xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
    xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
    xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
    IgnorableNamespaces="uap uap3 desktop rescap">

  <Identity Name="JobFoundry"
            Publisher="__PUBLISHER__"
            Version="__VERSION__.0"
            ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>JobFoundry</DisplayName>
    <PublisherDisplayName>JobFoundry</PublisherDisplayName>
    <Logo>assets\StoreLogo.png</Logo>
    <Description>Run the JobFoundry job-hunting stack locally on Windows.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22000.0" MaxVersionTested="10.0.26100.0" />
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.22000.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Capabilities>
    <!-- JobFoundry is a Win32 full-trust desktop app: it spawns bundled
         Node/Python/headless-chrome processes that bind localhost ports and
         write to %LOCALAPPDATA%\JobFoundry. The MSIX sandbox cannot do that,
         so runFullTrust is required (and the reason this is not a UWP app). -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>

  <Applications>
    <Application Id="JobFoundry"
                 Executable="JobFoundry.exe"
                 EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
          DisplayName="JobFoundry"
          Description="JobFoundry local stack"
          BackgroundColor="transparent"
          Square150x150Logo="assets\Square150x150Logo.png"
          Square44x44Logo="assets\Square44x44Logo.png" />
      <Extensions>
        <uap3:Extension Category="windows.appExecutionAlias"
                         Executable="jobfoundry.exe"
                         EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="jobfoundry.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>